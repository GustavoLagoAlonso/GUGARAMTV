# ============================================================
# GUGARAM TV Free — configuração do backend
# Copie este arquivo para ".env" e preencha os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (ver .gitignore).
# ============================================================

# Porta em que o servidor HTTP vai escutar
PORT=3000

# Segredo usado para assinar o cookie de sessão. Gere um valor
# aleatório longo, ex.: `openssl rand -hex 32`
SESSION_SECRET=

# URL PRIVADA da playlist IPTV (M3U/M3U8).
# Fica somente aqui. Nunca é enviada ao frontend.
IPTV_PLAYLIST_URL=

# Por quantos segundos a playlist processada fica em cache no
# backend antes de ser buscada novamente na origem.
IPTV_PLAYLIST_CACHE_TTL=300

# Credenciais do primeiro usuário administrador, usadas apenas
# uma vez pelo script "npm run seed" para criar o usuário inicial
# em server/data/db.json. Depois de rodar o seed, pode remover
# estes dois valores do .env se quiser.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail de suporte mostrado ao usuário em caso de erro
SUPPORT_EMAIL=gugaram@gmail.com
